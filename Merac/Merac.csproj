<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BronxSoft Netmetar Merac</AssemblyName>
    <RootNamespace>NetmetarMerac</RootNamespace>
    <ApplicationIcon>..\assets\merac.ico</ApplicationIcon>
    <Version>0.1.1</Version>
    <InformationalVersion>0.1.1-beta</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>BronxSoft Netmetar Merac</Product>
    <Company>BronxSoft</Company>
    <!-- one small .exe that uses the .NET installed on the computer -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
